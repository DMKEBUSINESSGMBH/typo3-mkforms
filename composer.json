{
    "name": "dmk/mkforms",
    "description": "Making HTML forms for TYPO3",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3 CMS",
        "forms",
        "formidable"
    ],
    "homepage": "http://www.dmk-ebusiness.de/",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Michael Wagner",
            "email": "michael.wagner@dmk-ebusiness.de",
            "role": "Developer"
        },
        {
            "name": "René Nitzsche",
            "email": "nitzsche@dmk-ebusiness.de",
            "role": "Developer"
        },
		{
			"name": "Hannes Bochmann",
			"email": "hannes.bochmann@dmk-ebusiness.de",
			"role": "Developer"
		}
    ],
    "support": {
        "email": "dev@dmk-ebusiness.de",
        "source": "https://github.com/DMKEBUSINESSGMBH/typo3-mkforms",
        "issues": "https://github.com/DMKEBUSINESSGMBH/typo3-mkforms"
    },
    "replace": {
        "typo3-ter/mkforms": "self.version"
    },
    "require": {
		"php": "^7.4 || ^8.0",
		"typo3/cms-core": "^11.5.7 || ^12.4.7",
		"digedag/rn-base": "^1.17"
	},
    "require-dev": {
        "dmk/mklib": "^12.0",
		"php-parallel-lint/php-parallel-lint": "^1.3",
		"friendsofphp/php-cs-fixer": "^3.3",
		"phpcompatibility/php-compatibility": "^9.3.5",
		"typo3/testing-framework": "^6.0 || ^7.0",
        "phpunit/phpunit": "^9.6",
        "veewee/composer-run-parallel": "^1.4"
    },
    "autoload": {
        "classmap": [
            "action/",
            "api/",
            "Classes/",
            "dh/",
            "ds/",
            "exception/",
            "forms/",
            "js/",
            "remote/",
            "renderer/",
            "session/",
            "util/",
            "validator/",
            "view/",
            "widgets/"
        ],
        "psr-4": {
            "DMK\\MkForms\\": "Classes"
        },
        "files": [
            "Classes/Constants.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "suggest": {
        "dmk/mksanitizedparameters": "keeps your parameters clean and safe"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "preferred-install": {
            "typo3/cms": "source"
        },
		"allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "phpstan/extension-installer": true,
            "veewee/composer-run-parallel": true
        }
    },
    "scripts": {
        "lint:php": [
			"[ -e .Build/bin/parallel-lint ] || composer update",
			"echo 'parallel-lint fails with a exception if executed inside the vendor/dmk/mkforms folder'",
			"[ ! -e ../../autoload.php ] || mv ../../autoload.php ../../autoload.php.bak",
			".Build/bin/parallel-lint --exclude .Build ./",
			"[ ! -e ../../autoload.php.bak ] || mv ../../autoload.php.bak ../../autoload.php"
        ],
        "lint": [
            "@lint:php"
        ],
        "test:phpcs": [
            "[ -e .Build/bin/php-cs-fixer ] || composer update --ansi",
            ".Build/bin/php-cs-fixer fix -v --dry-run --diff --ansi"
        ],
		"test:phpcompatibility": [
          "[ -e .Build/bin/phpcs ] || composer update",
			"@parallel test:phpcompatibility:7.4 test:phpcompatibility:8.0 test:phpcompatibility:8.1 test:phpcompatibility:8.2 test:phpcompatibility:8.3 test:phpcompatibility:8.4"
		],
		"test:phpcompatibility:7.4": [
			".Build/bin/phpcs --ignore=.Build/*,Resources/Public/JavaScript/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 7.4"
		],
		"test:phpcompatibility:8.0": [
			".Build/bin/phpcs --ignore=.Build/*,Resources/Public/JavaScript/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.0"
		],
		"test:phpcompatibility:8.1": [
			".Build/bin/phpcs --ignore=.Build/*,Resources/Public/JavaScript/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.1"
		],
		"test:phpcompatibility:8.2": [
			".Build/bin/phpcs --ignore=.Build/*,Resources/Public/JavaScript/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.2"
		],
		"test:phpcompatibility:8.3": [
			".Build/bin/phpcs --ignore=.Build/*,Resources/Public/JavaScript/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.3"
		],
		"test:phpcompatibility:8.4": [
			".Build/bin/phpcs --ignore=.Build/*,Resources/Public/JavaScript/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.4"
		],
        "test:phpunit": [
            "[ -e .Build/bin/phpunit ] || composer update --ansi",
          ".Build/bin/phpunit --colors=always"
        ],
        "test": [
            "@test:phpcs",
			"@test:phpcompatibility",
            "@test:phpunit"
        ],
        "fix:phpcs": [
            "[ -e .Build/bin/php-cs-fixer ] || composer update --ansi",
            ".Build/bin/php-cs-fixer fix -v"
        ],
        "fix": [
            "@fix:phpcs"
        ],
		"runqa": [
			"@fix",
			"@lint",
			"@test"
		]
	},
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "mkforms",
            "web-dir": ".Build/Web",
            "app-dir": ".Build"
        }
    }
}
